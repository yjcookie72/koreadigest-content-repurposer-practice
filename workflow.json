    {
      "parameters": {
        "jsCode": "// Aggregate all platform outputs into a single summary record\nconst items = $input.all();\nconst firstItem = items[0]?.json || {};\n\n// Collect all platform results\nconst platformResults = {};\nfor (const item of items) {\n  const d = item.json;\n  if (d.platform && d.content) {\n    platformResults[d.platform] = {\n      content: d.content,\n      status: d.status || 'generated',\n      char_count: d.char_count || d.content.length\n    };\n  }\n}\n\nconst platformsGenerated = Object.keys(platformResults);\nconst totalChars = Object.values(platformResults)\n  .reduce((sum, p) => sum + (p.char_count || 0), 0);\n\n// Build Slack summary message\nlet slackMessage = `*Content Repurposed Successfully* :white_check_mark:\\n`;\nslackMessage += `*Source:* ${firstItem.url || 'Unknown'}\\n`;\nslackMessage += `*Article:* ${firstItem.article?.title || 'Unknown'}\\n`;\nslackMessage += `*Platforms:* ${platformsGenerated.join(', ')}\\n`;\nslackMessage += `*Total content generated:* ${totalChars.toLocaleString()} characters\\n`;\nslackMessage += `*Timestamp:* ${firstItem.timestamp || new Date().toISOString()}\\n\\n`;\n\nfor (const [platform, data] of Object.entries(platformResults)) {\n  const preview = data.content.substring(0, 150).replace(/\\n/g, ' ');\n  slackMessage += `--- *${platform.toUpperCase()}* (${data.char_count} chars) ---\\n`;\n  slackMessage += `${preview}...\\n\\n`;\n}\n\nreturn [{\n  json: {\n    url: firstItem.url,\n    article_title: firstItem.article?.title || 'Unknown',\n    timestamp: firstItem.timestamp || new Date().toISOString(),\n    platforms_generated: platformsGenerated.join(', '),\n    linkedin_content: platformResults.linkedin?.content || '',\n    twitter_content: platformResults.twitter?.content || '',\n    newsletter_content: platformResults.newsletter?.content || '',\n    instagram_content: platformResults.instagram?.content || '',\n    total_characters: totalChars,\n    slack_message: slackMessage,\n    status: 'complete'\n  }\n}];"
      },
