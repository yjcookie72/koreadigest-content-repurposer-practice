      "id": "a1b2c3d4-1111-4000-a000-000000000005",
      "name": "Extract Article Content",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [720, 400]
    },
    {
      "parameters": {
        "jsCode": "// Clean and prepare extracted article text for AI processing\nconst input = $input.first().json;\n\nfunction cleanText(raw) {\n  if (!raw) return '';\n  \n  // Remove excessive whitespace and normalize line breaks\n  let text = raw\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\t/g, ' ')\n    .replace(/ {2,}/g, ' ')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n  \n  // Remove common boilerplate patterns\n  const boilerplatePatterns = [\n    /cookie\\s*(policy|consent|preferences)[^\\n]*/gi,\n    /subscribe\\s*(to\\s*our)?\\s*newsletter[^\\n]*/gi,\n    /share\\s*(this|on)\\s*(article|post|facebook|twitter|linkedin)[^\\n]*/gi,\n    /related\\s*(articles|posts|reads)[^\\n]*/gi,\n    /advertisement[^\\n]*/gi,\n    /sponsored\\s*content[^\\n]*/gi,\n    /\\d+\\s*comments?/gi,\n    /leave\\s*a\\s*(comment|reply)[^\\n]*/gi,\n    /sign\\s*up\\s*(for|to)[^\\n]*/gi,\n    /follow\\s*us\\s*on[^\\n]*/gi\n  ];\n  \n  for (const pattern of boilerplatePatterns) {\n    text = text.replace(pattern, '');\n  }\n  \n  // Clean up after removals\n  text = text.replace(/\\n{3,}/g, '\\n\\n').trim();\n  \n  return text;\n}\n\nfunction extractKeyPoints(text, maxPoints = 5) {\n  // Split into sentences and find the most substantive ones\n  const sentences = text\n    .split(/[.!?]+/)\n    .map(s => s.trim())\n    .filter(s => s.length > 40 && s.length < 300)\n    .filter(s => !s.match(/^(click|subscribe|sign up|follow|share|read more)/i));\n  \n  // Return the first N substantive sentences as key points\n  return sentences.slice(0, maxPoints);\n}\n\nconst title = cleanText(input.title) || 'Untitled Article';\nconst body = cleanText(input.body);\nconst metaDescription = cleanText(input.meta_description);\n\n// Truncate body to ~4000 chars for AI context window efficiency\nconst maxChars = 4000;\nconst truncatedBody = body.length > maxChars \n  ? body.substring(0, maxChars) + '... [truncated]'\n  : body;\n\nconst keyPoints = extractKeyPoints(body);\nconst wordCount = body.split(/\\s+/).length;\nconst readingTimeMin = Math.ceil(wordCount / 200);\n\nreturn [{\n  json: {\n    article: {\n      title,\n      body: truncatedBody,\n      fullBodyLength: body.length,\n      metaDescription,\n      keyPoints,\n      wordCount,\n      readingTimeMin\n    },\n    url: input.url,\n    platforms: input.platforms,\n    tone: input.tone,\n    author_handle: input.author_handle,\n    timestamp: input.timestamp\n  }\n}];"
      },
      "id": "a1b2c3d4-1111-4000-a000-000000000006",
      "name": "Clean & Prepare Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 400]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a LinkedIn content strategist who creates high-performing professional posts. You write in a clear, authoritative, and engaging tone. Every post must follow the hook-body-CTA framework."
            },
            {
              "role": "user",
              "content": "=Create a LinkedIn post from this article.\n\nArticle Title: {{ $json.article.title }}\nArticle Content: {{ $json.article.body }}\nAuthor Handle: {{ $json.author_handle }}\nTone: {{ $json.tone }}\n\nRules:\n- Start with a bold hook line (question, surprising stat, or contrarian take)\n- Use short paragraphs (1-2 sentences each)\n- Include 2-3 line breaks between sections for readability\n- Add bullet points or numbered lists for key takeaways\n- End with a clear call-to-action (question to drive comments)\n- Keep total length under 1300 characters\n- Do not use hashtags in the body (add 3-5 hashtags at the very end, separated by a blank line)\n- Do not use generic filler phrases like \"In today's world\" or \"It's no secret that\"\n- Write in first person when the tone is professional\n- Reference the original article with \"Link in comments\" at the end\n\nReturn ONLY the LinkedIn post text, nothing else."
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 600
        }
      },
